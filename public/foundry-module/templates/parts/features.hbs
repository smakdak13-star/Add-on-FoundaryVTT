{{!-- Способности и черты --}}
<section class="features-section">
  <h3>⭐ Способности и черты</h3>

  {{!-- Расовые черты --}}
  <div class="feature-category">
    <h4 class="category-header">
      🧬 Расовые черты
      <button type="button" class="item-create" data-type="race" title="Добавить расовую черту">+</button>
    </h4>
    <ol class="item-list">
      {{#each features.races}}
      <li class="item" data-item-id="{{this.id}}">
        <div class="item-name"><span>{{this.name}}</span></div>
        <div class="item-controls">
          <button type="button" class="item-edit" title="Редактировать">✏️</button>
          <button type="button" class="item-delete" title="Удалить">🗑️</button>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  {{!-- Классовые способности --}}
  <div class="feature-category">
    <h4 class="category-header">
      ⚔️ Классовые способности
      <button type="button" class="item-create" data-type="feat" title="Добавить способность">+</button>
    </h4>
    <ol class="item-list">
      {{#each features.feats}}
      <li class="item" data-item-id="{{this.id}}">
        <div class="item-name">
          <button type="button" class="item-roll" title="Использовать">{{this.name}}</button>
        </div>
        {{#if this.system.uses.max}}
        <div class="item-detail item-uses">
          {{this.system.uses.value}}/{{this.system.uses.max}}
        </div>
        {{/if}}
        <div class="item-controls">
          <button type="button" class="item-edit" title="Редактировать">✏️</button>
          <button type="button" class="item-delete" title="Удалить">🗑️</button>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  {{!-- Предыстория --}}
  <div class="feature-category">
    <h4 class="category-header">
      📜 Предыстория
    </h4>
    <ol class="item-list">
      {{#each features.backgrounds}}
      <li class="item" data-item-id="{{this.id}}">
        <div class="item-name"><span>{{this.name}}</span></div>
        <div class="item-controls">
          <button type="button" class="item-edit" title="Редактировать">✏️</button>
          <button type="button" class="item-delete" title="Удалить">🗑️</button>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  {{!-- Черты и особенности --}}
  <div class="feature-category">
    <h4 class="category-header">
      🏅 Черты и особенности
    </h4>
    <div class="trait-section">
      <div class="trait-block">
        <label>Владение доспехами</label>
        <span class="trait-value">{{system.traits.armor.value}}</span>
      </div>
      <div class="trait-block">
        <label>Владение оружием</label>
        <span class="trait-value">{{system.traits.weapon.value}}</span>
      </div>
      <div class="trait-block">
        <label>Владение инструментами</label>
        <span class="trait-value">{{system.traits.tool.value}}</span>
      </div>
      <div class="trait-block">
        <label>Языки</label>
        <span class="trait-value">{{system.traits.languages.value}}</span>
      </div>
      <div class="trait-block">
        <label>Сопротивления</label>
        <span class="trait-value">{{system.traits.dr.value}}</span>
      </div>
      <div class="trait-block">
        <label>Иммунитеты</label>
        <span class="trait-value">{{system.traits.di.value}}</span>
      </div>
    </div>
  </div>
</section>
