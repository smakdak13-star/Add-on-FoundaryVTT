{{!-- Биография --}}
<section class="biography-section">
  <h3>📝 Биография</h3>

  <div class="bio-grid">
    <div class="bio-block">
      <label>Черты характера</label>
      <textarea name="system.details.trait">{{biography.trait}}</textarea>
    </div>
    <div class="bio-block">
      <label>Идеалы</label>
      <textarea name="system.details.ideal">{{biography.ideal}}</textarea>
    </div>
    <div class="bio-block">
      <label>Привязанности</label>
      <textarea name="system.details.bond">{{biography.bond}}</textarea>
    </div>
    <div class="bio-block">
      <label>Слабости</label>
      <textarea name="system.details.flaw">{{biography.flaw}}</textarea>
    </div>
  </div>

  <div class="bio-full">
    <div class="bio-block">
      <label>Внешность</label>
      <textarea name="system.details.appearance" class="bio-textarea-large">{{biography.appearance}}</textarea>
    </div>
    <div class="bio-block">
      <label>Предыстория</label>
      <textarea name="system.details.biography.value" class="bio-textarea-large">{{biography.value}}</textarea>
    </div>
    <div class="bio-block">
      <label>Союзники и организации</label>
      <textarea name="system.details.allies" class="bio-textarea-large">{{biography.allies}}</textarea>
    </div>
    <div class="bio-block">
      <label>Дополнительные заметки</label>
      <textarea name="system.details.notes" class="bio-textarea-large">{{biography.notes}}</textarea>
    </div>
  </div>
</section>
