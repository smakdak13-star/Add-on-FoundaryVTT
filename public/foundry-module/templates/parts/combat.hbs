{{!-- Боевые параметры --}}
<section class="combat-section">
  <h3 class="section-title">⚔️ Боевые параметры</h3>

  <div class="combat-stats">
    <div class="stat-block ac-block">
      <label>КД</label>
      <span class="stat-value">{{combat.ac.value}}</span>
    </div>
    <div class="stat-block init-block">
      <label>Инициатива</label>
      <span class="stat-value">{{combat.initiative}}</span>
    </div>
    <div class="stat-block speed-block">
      <label>Скорость</label>
      <span class="stat-value">{{combat.speed}} фт.</span>
    </div>
  </div>

  <div class="hp-section">
    <div class="hp-header">
      <label>Хиты</label>
      <span class="hp-max">{{combat.hp.max}}</span>
    </div>
    <div class="hp-bar">
      <input type="number" name="system.attributes.hp.value" value="{{combat.hp.value}}"
        data-dtype="Number" class="hp-current" />
      <span class="hp-divider">/</span>
      <span class="hp-max-display">{{combat.hp.max}}</span>
    </div>
    <div class="hp-temp">
      <label>Временные</label>
      <input type="number" name="system.attributes.hp.temp" value="{{combat.hp.temp}}"
        data-dtype="Number" />
    </div>
  </div>

  <div class="hit-dice-section">
    <label>Кости хитов</label>
    <span class="hit-dice-display">{{system.attributes.hd}} / {{system.details.level}}</span>
  </div>

  <div class="death-saves">
    <label>Спасброски от смерти</label>
    <div class="death-save-row">
      <span class="death-label success">Успехи</span>
      <div class="death-dots">
        {{#times 3}}
        <span class="death-dot success {{#if (lte this ../combat.death.success)}}filled{{/if}}"></span>
        {{/times}}
      </div>
    </div>
    <div class="death-save-row">
      <span class="death-label failure">Провалы</span>
      <div class="death-dots">
        {{#times 3}}
        <span class="death-dot failure {{#if (lte this ../combat.death.failure)}}filled{{/if}}"></span>
        {{/times}}
      </div>
    </div>
    <button type="button" class="death-save-roll" title="Бросить спасбросок от смерти">🎲 Бросить</button>
  </div>

  <div class="passive-section">
    <div class="passive-stat">
      <label>Пассивное восприятие</label>
      <span>{{passivePerception}}</span>
    </div>
    <div class="passive-stat">
      <label>Пассивное расследование</label>
      <span>{{passiveInvestigation}}</span>
    </div>
  </div>

  <div class="rest-buttons">
    <button type="button" class="short-rest" title="Короткий отдых">🌙 Короткий отдых</button>
    <button type="button" class="long-rest" title="Длинный отдых">☀️ Длинный отдых</button>
  </div>
</section>
