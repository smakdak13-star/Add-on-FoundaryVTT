{{!-- Заголовок листа персонажа --}}
<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
  <div class="header-details">
    <h1 class="character-name">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Имя персонажа" />
    </h1>
    <div class="character-summary">
      <span class="race">{{system.details.race}}</span>
      <span class="class">{{system.details.class}}</span>
      <span class="level">Уровень {{system.details.level}}</span>
      <span class="alignment">{{system.details.alignment}}</span>
    </div>
    <div class="character-details">
      <div class="detail-group">
        <label>Предыстория</label>
        <span>{{system.details.background}}</span>
      </div>
      <div class="detail-group">
        <label>Опыт</label>
        <input type="number" name="system.details.xp.value" value="{{system.details.xp.value}}" />
      </div>
      <div class="detail-group">
        <label>Бонус мастерства</label>
        <span class="prof-bonus">+{{combat.proficiency}}</span>
      </div>
      <div class="detail-group inspiration-group">
        <button type="button" class="inspiration-toggle {{#if combat.inspiration}}active{{/if}}" title="Вдохновение">
          ⭐ Вдохновение
        </button>
      </div>
    </div>
  </div>
</header>
