{{!-- Заклинания --}}
<section class="spells-section">
  <h3>✨ Заклинания</h3>

  {{!-- Ячейки заклинаний --}}
  <div class="spell-slots-bar">
    {{#each spells.spellSlots}}
    {{#if this.max}}
    <div class="spell-slot-level">
      <label>{{@key}}-й круг</label>
      <div class="slot-dots">
        {{#times this.max}}
        <span class="slot-dot {{#if (lte this ../this.value)}}filled{{/if}}"></span>
        {{/times}}
      </div>
      <span class="slot-count">{{this.value}}/{{this.max}}</span>
    </div>
    {{/if}}
    {{/each}}
  </div>

  {{!-- Книга заклинаний --}}
  {{#each spells.spellbook}}
  <div class="spell-level-section">
    <h4 class="spell-level-header">
      {{#if (eq @key 0)}}Заговоры{{else}}{{@key}}-й круг{{/if}}
      <button type="button" class="item-create" data-type="spell" title="Добавить заклинание">+</button>
    </h4>
    <ol class="item-list spell-list">
      {{#each this}}
      <li class="item spell-item" data-item-id="{{this.id}}">
        <div class="spell-name">
          <button type="button" class="spell-roll item-roll" title="Сотворить заклинание">
            {{this.name}}
          </button>
          {{#if this.system.components.v}}<span class="comp-tag" title="Вербальный">В</span>{{/if}}
          {{#if this.system.components.s}}<span class="comp-tag" title="Соматический">С</span>{{/if}}
          {{#if this.system.components.m}}<span class="comp-tag material" title="Материальный">М</span>{{/if}}
          {{#if this.system.ritual}}<span class="comp-tag ritual" title="Ритуал">Р</span>{{/if}}
          {{#if this.system.concentration}}<span class="comp-tag concentration" title="Концентрация">К</span>{{/if}}
        </div>
        <div class="spell-details">
          <span class="spell-school">{{this.system.school}}</span>
          <span class="spell-range">{{this.system.range.value}} {{this.system.range.units}}</span>
          <span class="spell-time">{{this.system.activation.type}}</span>
        </div>
        <div class="item-controls">
          {{#if (gt this.system.level 0)}}
          <button type="button" class="spell-prepared" title="Подготовлено">
            {{#if this.prepared}}✅{{else}}⬜{{/if}}
          </button>
          {{/if}}
          <button type="button" class="item-edit" title="Редактировать">✏️</button>
          <button type="button" class="item-delete" title="Удалить">🗑️</button>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>
  {{/each}}

  {{#unless spells.spellbook}}
  <p class="no-spells">Нет известных заклинаний. Добавьте заклинания из компендиума.</p>
  {{/unless}}
</section>
